{
  "name": "cbuild",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "antlr4ts": "antlr4ts -visitor cbuild.g4 -o ./src/parser",
    "generate-parser": "antlr-ng  -Dlanguage=TypeScript --generate-listener true --generate-visitor true  cbuild.g4 -o ./src/parser",
    "test": "vitest run",
    "build:dev": "tsc -p ./tsconfig.dev.json",
    "build": "tsc -p ./tsconfig.prod.json",
    "disable-generated-typecheck": "npx tsx ./scripts/disable-generated-typecheck.ts",
    "start": "npm run build && node main.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "antlr-ng": "^1.0.10",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16",
    "antlr4ts": "^0.5.0-alpha.4",
    "vitest": "^5.0.0"
  }
}
