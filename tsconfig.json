{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "outDir": "./dist",
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./"],
      "@src/*": ["./src/*"],
      "@parser/*": ["./src/parser/*"],
      "@compiler/*": ["./src/compiler/*"],
      "@gnu-make-functions/*": ["./src/gnu-make-functions/*"],
      "@tests/*": ["./__tests__/*"]
    }
  }
}
